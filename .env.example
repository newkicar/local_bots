# Local Dots 配置样例：复制为 .env（.env 不入仓库）

# 单用户 Bearer Token（回环内 API 认证）
LD_API_TOKEN=change-me-please

# 同时执行的 Run 上限（超出进 FIFO 持久等待队列，ADR-0003）
LD_MAX_CONCURRENT_RUNS=10

# 审批等待超时（分钟，ADR-0005；计时自 Run 进入 waiting-approval 起算）
LD_APPROVAL_TIMEOUT_MIN=30

# 数据与工作目录
LD_DATA_DIR=data
LD_WORKSPACE_DIR=workspace

# 秘书模型（独立配置，不依赖 Codex 模型）
# 换成你的模型网关实际支持的模型名
LD_SECRETARY_MODEL=agnes-3.0-flash
# OpenAI 兼容端点，改为你自己网关的地址（示例值为作者本机的 mimo2codex）
LD_SECRETARY_BASE_URL=http://127.0.0.1:8788/v1
# 你网关要求的 API Key（本地网关可为任意值或留空）
LD_SECRETARY_API_KEY=mimo2codex
# 秘书只读文件发现授权目录（分号分隔）
# 按你本机实际放文件的目录改（分号分隔多个）
LD_SECRETARY_AUTHORIZED_DIRS=D:\

# Codex CLI 可执行名（本机 0.166.0，继承 ~/.codex/config.toml 的 mimo2codex 网关）
LD_CODEX_CLI=codex
